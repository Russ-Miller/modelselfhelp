{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelselfhelp.dev/schema/claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "weakness", "model", "version", "context", "observed_on", "severity", "status", "evidence", "submitted_by"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "weakness": { "$ref": "common.schema.json#/$defs/slug" },
    "model": { "$ref": "common.schema.json#/$defs/slug" },
    "version": { "$ref": "common.schema.json#/$defs/slug" },
    "context": { "$ref": "common.schema.json#/$defs/slug" },
    "observed_on": { "$ref": "common.schema.json#/$defs/date" },
    "severity": { "type": "string", "enum": ["minor", "moderate", "major", "blocking"] },
    "status": { "type": "string", "enum": ["open", "mitigated", "resolved", "disputed", "superseded"] },
    "superseded_by": { "$ref": "common.schema.json#/$defs/slug" },
    "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" }, "minItems": 1 },
    "notes": { "type": "string" },
    "submitted_by": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
