{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelselfhelp.dev/schema/claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "capability",
    "statement",
    "kind",
    "backing_strength",
    "sources",
    "contested",
    "status",
    "last_checked_at",
    "submitted_by"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "capability": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "technique": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "statement": {
      "type": "string",
      "minLength": 30
    },
    "tags": {
      "type": "array",
      "$ref": "common.schema.json#/$defs/slugList"
    },
    "kind": {
      "type": "string",
      "enum": [
        "mechanism",
        "observation"
      ]
    },
    "backing_strength": {
      "type": "string",
      "enum": [
        "single-paper",
        "replicated",
        "mechanism-reasoning",
        "own-observation"
      ]
    },
    "observed_on": {
      "$ref": "common.schema.json#/$defs/observedOn"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceLink"
      },
      "minItems": 1
    },
    "contested": {
      "type": "boolean"
    },
    "disagreement_axis": {
      "$ref": "common.schema.json#/$defs/disagreementAxis"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending-review",
        "active",
        "superseded",
        "retired"
      ],
      "description": "pending-review: ingested but not yet endorsed by a human. Browsable and linkable, but deliberately inert \u2014 it does not move a technique's standing, does not count toward the backtest, and is excluded anywhere a claim would otherwise carry weight. active: reviewed and held. superseded / retired: no longer current."
    },
    "superseded_by": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "last_checked_at": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "last_new_evidence_at": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "notes": {
      "type": "string"
    },
    "submitted_by": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
