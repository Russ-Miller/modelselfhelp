{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelselfhelp.dev/schema/model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "vendor", "versions"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "label": { "type": "string" },
    "vendor": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "label": { "type": "string" },
          "released": { "$ref": "common.schema.json#/$defs/date" }
        }
      }
    }
  }
}
