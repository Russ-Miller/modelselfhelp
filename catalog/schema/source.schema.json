{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelselfhelp.dev/schema/source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "ingested_at"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "kind": { "type": "string", "enum": ["paper", "observation"] },
    "title": { "type": "string", "minLength": 5 },
    "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
    "date": { "$ref": "common.schema.json#/$defs/date" },
    "arxiv_id": { "type": "string", "pattern": "^\\d{4}\\.\\d{4,5}(v\\d+)?$" },
    "url": { "type": "string", "format": "uri" },
    "venue": { "type": "string" },
    "summary": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "code_url": { "type": "string", "format": "uri" },
    "ingested_at": { "$ref": "common.schema.json#/$defs/date" }
  }
}
