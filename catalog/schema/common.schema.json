{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelselfhelp.dev/schema/common.schema.json",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slugList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "string",
      "pattern": "^(human|agent):[A-Za-z0-9._@-]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "stance",
        "note"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/slug"
        },
        "stance": {
          "type": "string",
          "enum": [
            "supports",
            "contests"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        },
        "submitted_by": {
          "$ref": "#/$defs/provenance"
        },
        "added_at": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "disagreementAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "is_guess"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 10
        },
        "is_guess": {
          "type": "boolean"
        }
      }
    },
    "observedOn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/slug"
        },
        "era": {
          "type": "string"
        },
        "task_type": {
          "$ref": "#/$defs/slug"
        }
      }
    }
  }
}
