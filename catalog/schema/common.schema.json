{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelselfhelp.dev/schema/common.schema.json",
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slugList": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "status": { "type": "string", "enum": ["proposed", "accepted", "disputed", "retired"] },
    "provenance": { "type": "string", "pattern": "^(human|agent):[A-Za-z0-9._@-]+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper", "note"],
      "properties": {
        "paper": { "$ref": "#/$defs/slug" },
        "note": { "type": "string", "minLength": 10, "maxLength": 600 },
        "strength": { "type": "string", "enum": ["anecdotal", "benchmark", "controlled", "survey"] }
      }
    }
  }
}
